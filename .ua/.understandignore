# .understandignore — patterns for files/dirs to exclude from analysis
# Syntax: same as .gitignore (globs, # comments, ! negation, trailing / for dirs)
# Built-in defaults (node_modules/, .git/, dist/, build/, obj/, *.lock, *.min.js, etc.) always apply.

# --- Tooling / session dirs ---
.claude/
.idea/
.mvn/wrapper/
.ua/
.vscode/

# --- Tests (Java) ---
**/src/test/**

# --- Images & binary assets ---
assets/
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico

# --- Documentation ---
docs/

# --- Frontend (out of scope for backend-only analysis) ---
frontend/